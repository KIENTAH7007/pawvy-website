# Copy to .env.local for local development, and set the same variable in
# Railway's environment variables for production.
#
# NEXT_PUBLIC_ prefix is required (not just API_BASE_URL) — this value
# needs to be readable both server-side (product/shop pages, fetched at
# request time) and client-side (cart, account, login — genuinely personal
# pages that stay client-rendered).
NEXT_PUBLIC_API_BASE_URL=https://pawvy-app-production.up.railway.app
