+/* ---------- Mobile menu (hamburger + slide-in drawer) ---------- */
+.hamburger {
+  flex-direction: column; justify-content: center; align-items: center; gap: 5px;
+  width: 40px; height: 40px; background: none; border: none; cursor: pointer; padding: 0; flex-shrink: 0;
+}
+.hamburger span { width: 22px; height: 2px; background: var(--cream); border-radius: 2px; transition: transform .3s ease, opacity .3s ease; }
+.hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
+.hamburger.open span:nth-child(2) { opacity: 0; }
+.hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
+@media (max-width: 900px) { .hamburger { display: flex; } }
+
+.mobile-overlay {
+  position: fixed; inset: 0; background: rgba(20,33,61,.5); z-index: 149;
+  opacity: 0; pointer-events: none; transition: opacity .3s ease;
+}
+.mobile-overlay.open { opacity: 1; pointer-events: auto; }
+
+.mobile-drawer {
+  position: fixed; top: 0; right: 0; bottom: 0; width: min(320px, 84vw); z-index: 150;
+  background: var(--navy); padding: 100px 26px 40px; display: flex; flex-direction: column; gap: 4px;
+  transform: translateX(100%); transition: transform .35s cubic-bezier(.16,.8,.3,1);
+  overflow-y: auto;
+}
+.mobile-drawer.open { transform: translateX(0); }
+.mobile-link {
+  display: flex; align-items: center; justify-content: space-between; gap: 8px;
+  padding: 15px 4px; font-size: 17px; font-weight: 800; color: var(--cream);
+  border-bottom: 1px solid rgba(245,242,235,.1); background: none; border-left: none; border-right: none; border-top: none;
+  width: 100%; text-align: left; cursor: pointer; font-family: inherit;
+}
+.mobile-shop-toggle .chev { width: 18px; height: 18px; transition: transform .25s ease; }
+.mobile-shop.open .mobile-shop-toggle .chev { transform: rotate(180deg); }
+.mobile-shop-list { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
+.mobile-shop.open .mobile-shop-list { max-height: 400px; }
+.mobile-sublink { display: block; padding: 12px 4px 12px 16px; font-size: 15px; font-weight: 700; color: rgba(245,242,235,.75); }
+.mobile-drawer-divider { height: 1px; background: rgba(245,242,235,.1); margin: 10px 0; }
+.mobile-greeting { color: var(--cream); }
+.mobile-auth-row { display: flex; flex-direction: column; gap: 12px; margin-top: 6px; }
+.mobile-auth-row .btn { justify-content: center; }
+@media (min-width: 901px) { .mobile-overlay, .mobile-drawer { display: none; } }
 @media (max-width: 1080px) { .foc-pill { display: none; } }
-@media (max-width: 900px) { .nav-links { display: none; } }
